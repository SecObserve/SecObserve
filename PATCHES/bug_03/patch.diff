--- a/backend/unittests/commons/services/test_settings_validation.py
+++ b/backend/unittests/commons/services/test_settings_validation.py
@@ -0,0 +1,28 @@
+from django.core.exceptions import ImproperlyConfigured
+from django.test import SimpleTestCase
+
+from application.commons.services.settings_validation import (
+    validate_field_encryption_key,
+)
+
+
+class TestSettingsValidation(SimpleTestCase):
+    def test_burned_default_key_rejected(self):
+        # The key committed to the shipped compose files must fail closed.
+        with self.assertRaises(ImproperlyConfigured):
+            validate_field_encryption_key(
+                "DtlkqVb3wlaVdJK_BU-3mB4wwuuf8xx8YNInajiJ7GU="
+            )
+
+    def test_empty_key_rejected(self):
+        with self.assertRaises(ImproperlyConfigured):
+            validate_field_encryption_key("")
+
+    def test_fresh_key_accepted(self):
+        # A unique, operator-generated key passes through unchanged.
+        fresh = "Hh3oQ2nbpr9Sa0sJ4vSh8kq0d-1vQ2yE5xZ7wA8bC9k="
+        self.assertEqual(
+            fresh, validate_field_encryption_key(fresh)
+        )
