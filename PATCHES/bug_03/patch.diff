--- a/backend/application/commons/services/settings_validation.py
+++ b/backend/application/commons/services/settings_validation.py
@@ -0,0 +1,30 @@
+from django.core.exceptions import ImproperlyConfigured
+
+# Fernet keys that have been published in this repository's shipped
+# compose files / CI scripts and must therefore be treated as burned.
+# A deployment that boots with one of these is running without effective
+# at-rest encryption for every EncryptedCharField (JWT_Secret.secret,
+# Api_Configuration credentials, ...).
+BURNED_FIELD_ENCRYPTION_KEYS = frozenset(
+    {
+        "DtlkqVb3wlaVdJK_BU-3mB4wwuuf8xx8YNInajiJ7GU=",
+    }
+)
+
+
+def validate_field_encryption_key(key: str) -> str:
+    """Fail closed on an unset or publicly-known FIELD_ENCRYPTION_KEY.
+
+    Raises ImproperlyConfigured so the application refuses to boot rather
+    than silently using a globally-known key.
+    """
+    if not key:
+        raise ImproperlyConfigured(
+            "FIELD_ENCRYPTION_KEY is not set. Generate a fresh Fernet key per "
+            "deployment; see docs/getting_started/configuration.md."
+        )
+    if key in BURNED_FIELD_ENCRYPTION_KEYS:
+        raise ImproperlyConfigured(
+            "FIELD_ENCRYPTION_KEY equals a publicly-known default. Generate a "
+            "fresh Fernet key per deployment; the committed default is burned."
+        )
+    return key
