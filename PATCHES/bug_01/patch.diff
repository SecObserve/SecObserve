+from django.db import connection
+
+from application.core.models import Product
+from unittests.base_test_case import BaseTestCase
+
+
+class TestIssueTrackerApiKeyEncryption(BaseTestCase):
+    def test_api_key_encrypted_at_rest(self):
+        secret = "ghp_super_secret_token_value"
+        product = Product.objects.create(name="encrypt_test_product", issue_tracker_api_key=secret)
+
+        # The ORM transparently decrypts on read.
+        reloaded = Product.objects.get(pk=product.pk)
+        self.assertEqual(secret, reloaded.issue_tracker_api_key)
+
+        # The raw DB column must NOT contain the plaintext token.
+        with connection.cursor() as cursor:
+            cursor.execute(
+                "SELECT issue_tracker_api_key FROM core_product WHERE id = %s",
+                [product.pk],
+            )
+            raw_value = cursor.fetchone()[0]
+
+        self.assertIsNotNone(raw_value)
+        self.assertNotEqual(secret, raw_value)
+        self.assertNotIn(secret, raw_value)
