+import encrypted_model_fields.fields
+from django.core.paginator import Paginator
+from django.db import migrations
+
+
+def reencrypt_issue_tracker_api_key(apps, schema_editor):
+    # Existing rows hold the api key as plaintext. After the field becomes an
+    # EncryptedCharField, EncryptedMixin.to_python tolerates the plaintext
+    # (InvalidToken -> returned as-is), so reading is safe; re-saving runs the
+    # value through get_db_prep_save, which encrypts it at rest.
+    Product = apps.get_model("core", "Product")
+    products = Product.objects.exclude(issue_tracker_api_key="").order_by("id")
+
+    paginator = Paginator(products, 1000)
+    for page_number in paginator.page_range:
+        page = paginator.page(page_number)
+        updates = list(page.object_list)
+        Product.objects.bulk_update(updates, ["issue_tracker_api_key"])
+
+
+class Migration(migrations.Migration):
+    dependencies = [
+        ("core", "0086_observation_assessment_vex_remediations_and_more"),
+    ]
+
+    operations = [
+        migrations.AlterField(
+            model_name="product",
+            name="issue_tracker_api_key",
+            field=encrypted_model_fields.fields.EncryptedCharField(blank=True),
+        ),
+        migrations.RunPython(
+            reencrypt_issue_tracker_api_key,
+            reverse_code=migrations.RunPython.noop,
+        ),
+    ]
