--- a/backend/application/core/api/serializers_product.py
+++ b/backend/application/core/api/serializers_product.py
@@ -122,6 +122,11 @@ class ProductCoreSerializer(ModelSerializer):
     def to_representation(self, instance: Product) -> dict[str, Any]:
         data = super().to_representation(instance)
 
+        # Only users who can edit a product are allowed to see the issue tracker API key
+        permissions = data.get("permissions") or []
+        if Permissions.Product_Edit not in permissions:
+            data.pop("issue_tracker_api_key", None)
+
         data["observation_notification_status_list"] = (
             instance.observation_notification_statuses.split(",") if instance.observation_notification_statuses else []
         )
         return data
--- a/backend/unittests/core/api/test_serializers.py
